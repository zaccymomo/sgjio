{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sgjio.example.com/contracts/events/identity.password_reset.requested.schema.json",
  "title": "identity.password_reset.requested",
  "description": "Someone asked for a password reset for an existing account. Notification sends password_reset_email (method=password) or google_account_email (method=google: the account has no password). aggregate_id = user_id; aggregate_version is always 1 (Notification dedupes by event_id). Carries a one-time link and an email address: internal broker only, never logged.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "identity.password_reset.requested"
    },
    "producer": {
      "const": "identity"
    },
    "aggregate_type": {
      "const": "user"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "email",
        "name",
        "audience",
        "method"
      ],
      "properties": {
        "user_id": {
          "$ref": "envelope.schema.json#/$defs/uuid"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "audience": {
          "enum": [
            "app",
            "admin"
          ],
          "description": "Which front end: admin sends the admin wording (for_admin=True)."
        },
        "method": {
          "enum": [
            "password",
            "google"
          ]
        },
        "link": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2000,
          "description": "method=password: <WEB_URL or ADMIN_URL>/reset-password?token=..."
        },
        "expires_in_minutes": {
          "type": "integer",
          "minimum": 1,
          "description": "method=password: RESET_TOKEN_MINUTES"
        },
        "sign_in_url": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2000,
          "description": "method=google: <WEB_URL>/sign-in"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "password"
              }
            }
          },
          "then": {
            "required": [
              "link",
              "expires_in_minutes"
            ],
            "properties": {
              "sign_in_url": false
            }
          },
          "else": {
            "required": [
              "sign_in_url"
            ],
            "properties": {
              "link": false,
              "expires_in_minutes": false
            }
          }
        }
      ]
    },
    "aggregate_version": {
      "const": 1
    }
  }
}
