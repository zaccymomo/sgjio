# Copy to services/identity/.env to run Identity on the host (docker-compose.yml sets all of
# these for the container). Never commit .env.

# --- Database (compose identity-db, host port 5433) ---
DATABASE_URL=postgresql+psycopg://identity:identity@localhost:5433/identity
TEST_DATABASE_URL=postgresql+psycopg://identity:identity@localhost:5433/identity_test

# --- Plumbing (app/platform) ---
SERVICE_NAME=identity
GATEWAY_KEY=dev-gateway-key    # the gateway's key; /internal/auth/* refuses requests without it
BROKER_URL=amqp://sgjio:sgjio@localhost:5672/%2F
RUN_RELAY=true                 # publish the outbox from this process
LOG_LEVEL=INFO

# --- Front-end addresses (used in email links) ---
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# --- Sessions and sign-in (see docs/decisions.md) ---
COOKIE_SECURE=false
APP_SESSION_DAYS=7
ADMIN_SESSION_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
RESET_TOKEN_MINUTES=15         # 15 on this branch: email is sent asynchronously

# --- Administrators (SCRUM-81) ---
INVITE_LINK_HOURS=72
ADMIN_EMAIL_DOMAIN=sgjio.example.com

# --- Sign in with Google (SCRUM-92) ---
FIREBASE_PROJECT_ID=sgjio-966a1

# --- Seed accounts (development only) ---
SEED_ADMIN_EMAIL=admin@sgjio.example.com
SEED_ADMIN_PASSWORD=AdminPass123
SEED_USER_EMAIL=newcomer@sgjio.example.com
SEED_USER_PASSWORD=UserPass123
