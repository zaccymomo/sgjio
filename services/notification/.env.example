# Copy to services/notification/.env to run the worker on the host (docker-compose.yml sets
# all of these for the container). Never commit .env.
DATABASE_URL=postgresql+psycopg://notification:notification@localhost:5436/notification
TEST_DATABASE_URL=postgresql+psycopg://notification:notification@localhost:5436/notification_test

# app/platform reads these from the shell environment only, not from this file; the
# defaults suit a host run against docker compose:
#   export BROKER_URL=amqp://sgjio:sgjio@localhost:5672/%2F   # default
#   export RUN_CONSUMER=true                                   # default
#   export LOG_LEVEL=INFO                                      # default
# SERVICE_NAME defaults to "notification" (app/db.py).

# "smtp" sends through the server below (Mailpit from docker compose); "console" logs them.
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=SGJio <no-reply@sgjio.example.com>
