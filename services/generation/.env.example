# Copy to services/generation/.env to run the worker on the host (docker-compose.yml sets
# all of these for the container, from the shell or the root .env). Never commit .env, and
# never put a real key in this file.
DATABASE_URL=postgresql+psycopg://generation:generation@localhost:5438/generation
TEST_DATABASE_URL=postgresql+psycopg://generation:generation@localhost:5438/generation_test

# app/platform reads these from the shell environment only, not from this file; the
# defaults suit a host run against docker compose:
#   export BROKER_URL=amqp://sgjio:sgjio@localhost:5672/%2F   # default
#   export RUN_CONSUMER=true RUN_RELAY=true                    # defaults
# SERVICE_NAME defaults to "generation" (app/db.py).

# false fails every request at once with code "provider" (the kill switch).
GENERATION_ENABLED=true
# true uses the built-in fake model (no key, no network). Set false for the real model.
GENERATION_FAKE=true
# An OpenAI-compatible API: NUS SoC LaaS. Get a personal key at
# https://soclaas-portal.comp.nus.edu.sg/ (SoC account, from the NUS network or VPN); the API
# itself is reachable from anywhere. List the models your key can use with
#   curl -H "Authorization: Bearer $GENERATION_API_KEY" https://soclaas-api.comp.nus.edu.sg/v1/models
# and pick a chat-capable one. The base URL already ends in /v1.
GENERATION_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
GENERATION_API_KEY=
# Chosen in docs/ai-model-evaluation.md: qwen3.6:35b is fast; x-test-2 (DeepSeek) writes the
# best lessons but takes about 30 to 60 s.
GENERATION_MODEL=qwen3.6:35b
# The answer-check model; empty means the same as GENERATION_MODEL.
GENERATION_CHECK_MODEL=ornith1.5:35b
# Tried once when a call to the main model fails (e.g. a trial model is withdrawn).
GENERATION_FALLBACK_MODEL=ornith1.5:35b
GENERATION_TIMEOUT_SECONDS=120
