# SGJio API gateway. Rendered by envsubst when the container starts: ${NAME} values come from
# the environment (GATEWAY_KEY, IDENTITY_UPSTREAM, CONTENT_UPSTREAM, LEARNING_UPSTREAM,
# MEDIA_MAX_MB); $name values are nginx's own variables and are left alone.
#
# Routing table: docs/architecture/detailed-plan.md section 5.2, with the build plan's auth
# contract (contracts/README.md): no auth cache, every protected request asks Identity.
# Regex locations win over prefix locations, so the two regex routes below take their paths
# away from /api/admin/lessons (Content) and /api/lessons/ (Learning).

# Correlation id: the client's X-Request-ID if it sent one, otherwise a fresh one.
map $http_x_request_id $req_id {
    ""      $request_id;
    default $http_x_request_id;
}

map $request_id $gateway_key {
    default "${GATEWAY_KEY}";
}

log_format gateway_json escape=json
    '{"time":"$time_iso8601","service":"gateway","request_id":"$req_id",'
    '"remote_addr":"$remote_addr","method":"$request_method","uri":"$request_uri",'
    '"status":$status,"bytes_sent":$body_bytes_sent,"request_time":$request_time,'
    '"upstream":"$upstream_addr","upstream_status":"$upstream_status",'
    '"upstream_time":"$upstream_response_time"}';

server {
    listen 8080;
    server_name _;
    server_tokens off;
    access_log /dev/stdout gateway_json;

    # Docker's DNS, asked per request (upstreams are variables), so the gateway starts and
    # keeps serving other routes while a service is down.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 2s;

    client_max_body_size 10m;
    proxy_http_version 1.1;
    proxy_connect_timeout 2s;
    proxy_send_timeout 15s;
    proxy_read_timeout 15s;
    proxy_intercept_errors off;

    include snippets/errors.inc;
    error_page 413 @too_large;

    # --- Regex routes (checked before the prefix routes they overlap) ----------------
    # 1. Lesson insights: Learning, admin.
    location ~ ^/api/admin/lessons/[^/]+/insights$ {
        set $upstream ${LEARNING_UPSTREAM};
        auth_request /_auth/admin;
        include snippets/principal.inc;
        include snippets/proxy.inc;
    }

    # 2. A learner reporting a problem on a card: Content, app.
    location ~ ^/api/lessons/[^/]+/reports$ {
        set $upstream ${CONTENT_UPSTREAM};
        auth_request /_auth/app;
        include snippets/principal.inc;
        include snippets/proxy.inc;
    }

    # --- Identity: passed straight through; Identity checks its own cookies ------------
    # 3-8. Sign-in and accounts (both front ends), administrators, profile, introduction.
    location /api/auth/ {
        set $upstream ${IDENTITY_UPSTREAM};
        include snippets/public.inc;
        include snippets/proxy.inc;
    }

    location /api/admin/auth/ {
        set $upstream ${IDENTITY_UPSTREAM};
        include snippets/public.inc;
        include snippets/proxy.inc;
    }

    location /api/admin/admins {
        set $upstream ${IDENTITY_UPSTREAM};
        include snippets/public.inc;
        include snippets/proxy.inc;
    }

    location = /api/admin/ping {
        set $upstream ${IDENTITY_UPSTREAM};
        include snippets/public.inc;
        include snippets/proxy.inc;
    }

    location /api/profile {
        set $upstream ${IDENTITY_UPSTREAM};
        include snippets/public.inc;
        include snippets/proxy.inc;
    }

    location /api/intro/ {
        set $upstream ${IDENTITY_UPSTREAM};
        include snippets/public.inc;
        include snippets/proxy.inc;
    }

    # --- Content: authoring, admin scope ------------------------------------------------
    # 9-13.
    location /api/admin/topics {
        set $upstream ${CONTENT_UPSTREAM};
        auth_request /_auth/admin;
        include snippets/principal.inc;
        include snippets/proxy.inc;
    }

    location /api/admin/lessons {
        set $upstream ${CONTENT_UPSTREAM};
        auth_request /_auth/admin;
        include snippets/principal.inc;
        include snippets/proxy.inc;
    }

    # Uploads up to 20 MB reach Content, which applies its own limits (15 MB) and answers
    # media_too_large itself; anything larger is refused here with the same JSON.
    location /api/admin/media {
        set $upstream ${CONTENT_UPSTREAM};
        client_max_body_size 20m;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        include snippets/errors.inc;
        error_page 413 @media_too_large;
        auth_request /_auth/admin;
        include snippets/principal.inc;
        include snippets/proxy.inc;
    }

    location /api/admin/reports {
        set $upstream ${CONTENT_UPSTREAM};
        auth_request /_auth/admin;
        include snippets/principal.inc;
        include snippets/proxy.inc;
    }

    location /api/admin/aptitude-questions {
        set $upstream ${CONTENT_UPSTREAM};
        auth_request /_auth/admin;
        include snippets/principal.inc;
        include snippets/proxy.inc;
    }

    # 14. Lesson images and audio: public. Range and If-None-Match pass through, so
    # Content's 206, 304 and 416 reach the browser unchanged.
    location /api/media/ {
        set $upstream ${CONTENT_UPSTREAM};
        include snippets/public.inc;
        proxy_set_header Authorization "";
        include snippets/proxy.inc;
    }

    # --- Learning: learners' pages, app scope -------------------------------------------
    # 15-21. Aptitude uses the same app auth as the rest (there is no cache to bypass).
    location /api/lessons/ {
        set $upstream ${LEARNING_UPSTREAM};
        auth_request /_auth/app;
        include snippets/principal.inc;
        include snippets/proxy.inc;
    }

    location /api/attempts/ {
        set $upstream ${LEARNING_UPSTREAM};
        auth_request /_auth/app;
        include snippets/principal.inc;
        include snippets/proxy.inc;
    }

    location = /api/progress {
        set $upstream ${LEARNING_UPSTREAM};
        auth_request /_auth/app;
        include snippets/principal.inc;
        include snippets/proxy.inc;
    }

    location /api/topics/ {
        set $upstream ${LEARNING_UPSTREAM};
        auth_request /_auth/app;
        include snippets/principal.inc;
        include snippets/proxy.inc;
    }

    location = /api/search {
        set $upstream ${LEARNING_UPSTREAM};
        auth_request /_auth/app;
        include snippets/principal.inc;
        include snippets/proxy.inc;
    }

    location = /api/review {
        set $upstream ${LEARNING_UPSTREAM};
        auth_request /_auth/app;
        include snippets/principal.inc;
        include snippets/proxy.inc;
    }

    location /api/aptitude/ {
        set $upstream ${LEARNING_UPSTREAM};
        auth_request /_auth/app;
        include snippets/principal.inc;
        include snippets/proxy.inc;
    }

    # --- The gateway itself ---------------------------------------------------------------
    # 22. Liveness, in the monolith's shape. It does not check the services.
    location = /api/health {
        default_type application/json;
        add_header X-Request-ID $req_id always;
        return 200 '{"status":"ok"}';
    }

    # 23. Session checks against Identity (never reachable from outside: `internal`).
    location = /_auth/app {
        set $auth_upstream ${IDENTITY_UPSTREAM};
        proxy_pass http://$auth_upstream/internal/auth/app;
        include snippets/auth_request.inc;
    }

    location = /_auth/admin {
        set $auth_upstream ${IDENTITY_UPSTREAM};
        proxy_pass http://$auth_upstream/internal/auth/admin;
        include snippets/auth_request.inc;
    }

    # 24. Everything else, in FastAPI's shape.
    location / {
        return 404;
    }

    # --- JSON error bodies --------------------------------------------------------------
    location @not_signed_in {
        default_type application/json;
        add_header X-Request-ID $req_id always;
        return 401 '{"detail":{"code":"not_signed_in","message":"Please sign in to continue."}}';
    }

    location @not_found {
        default_type application/json;
        add_header X-Request-ID $req_id always;
        return 404 '{"detail":"Not Found"}';
    }

    location @too_large {
        default_type application/json;
        add_header X-Request-ID $req_id always;
        return 413 '{"detail":{"code":"payload_too_large","message":"That request is too large. The limit is 10 MB."}}';
    }

    location @media_too_large {
        default_type application/json;
        add_header X-Request-ID $req_id always;
        return 413 '{"detail":{"code":"media_too_large","message":"That file is too large. The limit is ${MEDIA_MAX_MB} MB."}}';
    }

    location @unavailable {
        default_type application/json;
        add_header X-Request-ID $req_id always;
        add_header Retry-After 5 always;
        return 503 '{"detail":{"code":"service_unavailable","message":"SGJio is unavailable right now. Please try again in a moment."}}';
    }

    location @timeout {
        default_type application/json;
        add_header X-Request-ID $req_id always;
        return 504 '{"detail":{"code":"gateway_timeout","message":"SGJio took too long to answer. Please try again."}}';
    }
}
