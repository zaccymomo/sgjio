# Copy this file to .env and adjust if needed. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://sgjio:sgjio@localhost:5432/sgjio
TEST_DATABASE_URL=postgresql+psycopg://sgjio:sgjio@localhost:5432/sgjio_test

# --- Front-end addresses (used in email links) ---
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# --- Sessions and sign-in (see docs/decisions.md) ---
COOKIE_SECURE=false            # set to true when served over HTTPS
APP_SESSION_DAYS=7             # main app: signed out after 7 days without use
ADMIN_SESSION_HOURS=8          # admin portal: signed out after 8 hours without use
LOGIN_MAX_FAILURES=5           # failed attempts in a row before a block
LOGIN_LOCKOUT_MINUTES=15       # length of the block
RESET_TOKEN_MINUTES=5          # password reset links expire after this

# --- Administrators (SCRUM-81) ---
INVITE_LINK_HOURS=72           # links in admin invite emails expire after this
ADMIN_EMAIL_DOMAIN=sgjio.example.com  # adding an admin outside it asks for confirmation; empty = no check

# --- Sign in with Google (SCRUM-92, README "Sign in with Google") ---
FIREBASE_PROJECT_ID=sgjio-966a1  # the team's Firebase project (same as web/.env.local); empty = off

# --- Email ---
# "smtp" sends through the server below. "console" prints emails to the terminal instead.
EMAIL_BACKEND=smtp
SMTP_HOST=localhost            # Mailpit from docker compose
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=SGJio <no-reply@sgjio.example.com>

# --- Images and audio for lesson cards ---
MEDIA_MAX_IMAGE_MB=15          # larger uploads are refused; images are shrunk to 1600px wide
MEDIA_MAX_AUDIO_MB=10
MEDIA_MAX_AUDIO_SECONDS=120    # card audio should be short; over 20 seconds is flagged

# --- Lesson files (content/README.md) ---
# CONTENT_DIR=../content/lessons   # where the seed and import-lessons look; this is the default

# --- Seed accounts (development only) ---
SEED_ADMIN_EMAIL=admin@sgjio.example.com
SEED_ADMIN_PASSWORD=AdminPass123
SEED_USER_EMAIL=newcomer@sgjio.example.com
SEED_USER_PASSWORD=UserPass123
