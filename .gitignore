# Patterns without a leading slash apply at every depth, so these cover services/*, e2e/,
# contracts/ and templates/platform/ too (.venv, .env, __pycache__, .pytest_cache, .ruff_cache).

# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# Build output
dist/
*.tsbuildinfo

# Local config and secrets
.env
.env.local
*.local
# ...except the shared start script
!dev.local

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
