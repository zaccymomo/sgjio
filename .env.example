# Settings for the Docker stack. docker-compose.yml reads a file called .env next to it.
#
#   cp .env.example .env      then fill in your own key below
#
# .env is git-ignored: never commit it, and never put a real key in this file.
# Without a .env everything still runs: AI-generated lessons use the built-in fake model.
# Full steps: README.md, "AI-generated lessons".

# --- AI-generated lessons (services/generation) ------------------------------------------

# true = the built-in fake model (no key needed); false = the real model below.
# Set it to false once you have put your key in GENERATION_API_KEY.
GENERATION_FAKE=true

# NUS SoC LaaS, an OpenAI-compatible API. Create a personal key at
# https://soclaas-portal.comp.nus.edu.sg/ (sign in with your SoC account, from the NUS
# network or NUS VPN). The API itself works from anywhere. The URL already ends in /v1.
GENERATION_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
GENERATION_API_KEY=

# Which models to use (docs/ai-model-evaluation.md compares them all):
#   writes the lesson: qwen3.6:35b (fast, about 10 to 15 s; the team default), or
#                      x-test-2 (DeepSeek: best lessons, about 30 to 60 s, a trial model)
#   checks the answers of learners' lessons: ornith1.5:35b
#   fallback: tried once if a call to the main model fails (down, withdrawn or too slow)
GENERATION_MODEL=qwen3.6:35b
GENERATION_CHECK_MODEL=ornith1.5:35b
GENERATION_FALLBACK_MODEL=ornith1.5:35b
# Seconds one model call may take before it counts as failed.
GENERATION_TIMEOUT_SECONDS=120

# false switches AI generation off: every request fails at once and is refunded.
# GENERATION_ENABLED=true
